// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  student
  teacher
  admin
}

enum TeacherRequestStatus {
  pending
  approved
  rejected
}

enum CommunityRole {
  student
  teacher
}

enum ContentType {
  video
  post
}

enum PostType {
  announcement
  doubt
  general
}

enum AssignmentSubmissionStatus {
  submitted
  late
  graded
}

enum ChatRequestStatus {
  pending
  accepted
  rejected
}

enum NotificationType {
  new_assignment
  new_video
  doubt_reply
  chat_request
  teacher_approved
}

model User {
  id                      String                 @id @default(uuid()) @db.Uuid
  name                    String                 @db.VarChar(255)
  username                String                 @unique @db.VarChar(255)
  email                   String                 @unique @db.VarChar(255)
  passwordHash            String?                @map("password_hash") @db.VarChar(255)
  avatarUrl               String?                @default("") @map("avatar_url") @db.Text
  bio                     String?                @default("") @db.Text
  role                    Role                   @default(student)
  isEmailVerified         Boolean                @default(false) @map("is_email_verified")
  oauthProvider           String?                @map("oauth_provider") @db.VarChar(50)
  oauthId                 String?                @map("oauth_id") @db.VarChar(255)
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt               DateTime?              @map("deleted_at") @db.Timestamptz
  emailVerifications      EmailVerification[]
  passwordResets          PasswordReset[]
  refreshTokens           RefreshToken[]
  teacherRequests         TeacherRequest[]       @relation("teacher_requester")
  reviewedTeacherRequests TeacherRequest[]       @relation("teacher_reviewer")
  communitiesCreated      Community[]            @relation("community_creator")
  communityMemberships    CommunityMember[]
  inviteLinksCreated      InviteLink[]
  contentsCreated         Content[]
  comments                Comment[]
  assignmentsCreated      Assignment[]
  assignmentSubmissions   AssignmentSubmission[]
  chatRequestsSent        ChatRequest[]          @relation("chat_request_sender")
  chatRequestsReceived    ChatRequest[]          @relation("chat_request_receiver")
  conversationsAsUserOne  Conversation[]         @relation("conversation_user_one")
  conversationsAsUserTwo  Conversation[]         @relation("conversation_user_two")
  chatMessages            ChatMessage[]
  notifications           Notification[]

  @@map("users")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("email_verifications")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("password_resets")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti        String   @unique @db.VarChar(255)
  tokenHash  String   @map("token_hash") @db.VarChar(255)
  isRevoked  Boolean  @default(false) @map("is_revoked")
  replacedBy String?  @map("replaced_by") @db.VarChar(255)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("refresh_tokens")
}

model TeacherRequest {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  user       User                 @relation("teacher_requester", fields: [userId], references: [id], onDelete: Cascade)
  status     TeacherRequestStatus @default(pending)
  reviewedBy String?              @map("reviewed_by") @db.Uuid
  reviewer   User?                @relation("teacher_reviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt DateTime?            @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  @@map("teacher_requests")
}

model Community {
  id            String            @id @default(uuid()) @db.Uuid
  name          String            @db.VarChar(255)
  description   String?           @default("") @db.Text
  createdBy     String            @map("created_by") @db.Uuid
  creator       User              @relation("community_creator", fields: [createdBy], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt     DateTime?         @map("deleted_at") @db.Timestamptz
  members       CommunityMember[]
  inviteLinks   InviteLink[]
  contents      Content[]
  assignments   Assignment[]
  notifications Notification[]

  @@index([createdBy], map: "idx_communities_created_by")
  @@map("communities")
}

model CommunityMember {
  id              String        @id @default(uuid()) @db.Uuid
  communityId     String        @map("community_id") @db.Uuid
  community       Community     @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId          String        @map("user_id") @db.Uuid
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleInCommunity CommunityRole @default(student) @map("role_in_community")
  joinedAt        DateTime      @default(now()) @map("joined_at") @db.Timestamptz
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([communityId, userId])
  @@index([userId], map: "idx_community_members_user_id")
  @@map("community_members")
}

model InviteLink {
  id          String    @id @default(uuid()) @db.Uuid
  communityId String    @map("community_id") @db.Uuid
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   String    @map("created_by") @db.Uuid
  creator     User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  token       String    @unique @db.VarChar(255)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz
  maxUses     Int?      @map("max_uses")
  useCount    Int       @default(0) @map("use_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@map("invite_links")
}

model Content {
  id          String      @id @default(uuid()) @db.Uuid
  communityId String      @map("community_id") @db.Uuid
  community   Community   @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   String      @map("created_by") @db.Uuid
  creator     User        @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  contentType ContentType @map("content_type")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?   @map("deleted_at") @db.Timestamptz
  video       Video?
  post        Post?
  comments    Comment[]

  @@index([communityId], map: "idx_contents_community_id")
  @@index([contentType], map: "idx_contents_type")
  @@map("contents")
}

model Video {
  id           String  @id @db.Uuid
  content      Content @relation(fields: [id], references: [id], onDelete: Cascade)
  title        String  @db.VarChar(255)
  description  String? @default("") @db.Text
  videoUrl     String  @map("video_url") @db.Text
  thumbnailUrl String? @default("") @map("thumbnail_url") @db.Text

  @@map("videos")
}

model Post {
  id       String   @id @db.Uuid
  content  Content  @relation(fields: [id], references: [id], onDelete: Cascade)
  postType PostType @map("post_type")
  body     String   @map("content") @db.Text

  @@map("posts")
}

model Comment {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentId       String    @map("content_id") @db.Uuid
  content         Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  parentCommentId String?   @map("parent_comment_id") @db.Uuid
  parentComment   Comment?  @relation("comment_replies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[] @relation("comment_replies")
  body            String    @map("content") @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  @@index([contentId], map: "idx_comments_content_id")
  @@map("comments")
}

model Assignment {
  id          String                 @id @default(uuid()) @db.Uuid
  communityId String                 @map("community_id") @db.Uuid
  community   Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  createdBy   String                 @map("created_by") @db.Uuid
  creator     User                   @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  title       String                 @db.VarChar(255)
  description String?                @default("") @db.Text
  fileUrl     String?                @default("") @map("file_url") @db.Text
  dueDate     DateTime               @map("due_date") @db.Timestamptz
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?              @map("deleted_at") @db.Timestamptz
  submissions AssignmentSubmission[]

  @@index([communityId], map: "idx_assignments_community_id")
  @@map("assignments")
}

model AssignmentSubmission {
  id           String                     @id @default(uuid()) @db.Uuid
  assignmentId String                     @map("assignment_id") @db.Uuid
  assignment   Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String                     @map("student_id") @db.Uuid
  student      User                       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String                     @map("file_url") @db.Text
  status       AssignmentSubmissionStatus @default(submitted)
  grade        String?                    @default("") @db.VarChar(50)
  feedback     String?                    @default("") @db.Text
  submittedAt  DateTime                   @default(now()) @map("submitted_at") @db.Timestamptz
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([assignmentId, studentId])
  @@index([assignmentId], map: "idx_assignment_submissions_assignment_id")
  @@map("assignment_submissions")
}

model ChatRequest {
  id          String            @id @default(uuid()) @db.Uuid
  senderId    String            @map("sender_id") @db.Uuid
  sender      User              @relation("chat_request_sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String            @map("receiver_id") @db.Uuid
  receiver    User              @relation("chat_request_receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  status      ChatRequestStatus @default(pending)
  respondedAt DateTime?         @map("responded_at") @db.Timestamptz
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  @@map("chat_requests")
}

model Conversation {
  id        String        @id @default(uuid()) @db.Uuid
  userOneId String        @map("user_one_id") @db.Uuid
  userOne   User          @relation("conversation_user_one", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwoId String        @map("user_two_id") @db.Uuid
  userTwo   User          @relation("conversation_user_two", fields: [userTwoId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  messages  ChatMessage[]

  @@unique([userOneId, userTwoId])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id") @db.Uuid
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz

  @@index([conversationId], map: "idx_chat_messages_conversation_id")
  @@map("chat_messages")
}

model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType
  refType     String           @map("ref_type") @db.VarChar(50)
  refId       String           @map("ref_id") @db.Uuid
  communityId String?          @map("community_id") @db.Uuid
  community   Community?       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  message     String           @db.Text
  isRead      Boolean          @default(false) @map("is_read")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([userId, createdAt(sort: Desc)], map: "idx_notifications_user_id")
  @@map("notifications")
}
